    {
      "parameters": {
        "jsCode": "// Look at every existing row's \"id\" column and take the highest one.\n// Starting at 0 means the very first run produces id = 1.\nconst rows = $input.all();\n\nconst existingIds = rows\n  .map(row => Number(row.json.id))\n  .filter(n => !isNaN(n));\n\nconst nextId = existingIds.length > 0 ? Math.max(...existingIds) + 1 : 1;\n\nreturn [{ json: { id: nextId } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [672, 0],
